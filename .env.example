# XTools（超兔）OPEN API 凭证 —— 复制为 .env 后填写；.env 已在 .gitignore 中，不要提交到仓库
# 六项凭证均由 XTools 客户专员开通 Open API 后提供（网页登录账号密码不能代替）

XTOOLS_APPID=            # 开发公司应用 ID，示例 open00001_sajdjsjsj
XTOOLS_APPKEY=           # 应用密钥，参与每次请求的 md 签名
XTOOLS_COMKEYID=         # XTools 分配给客户公司的 comkeyid，明文放在登录 upr 中
XTOOLS_COMKEY=           # 客户公司 key，参与登录验证码计算（文档示例中与 comkeyid 不同，需分别索取）
XTOOLS_COM=              # XToolsCRM 中的客户公司内部编码，示例 d002
XTOOLS_PART=B1           # 接口登录人 part；写入数据的默认所有者即该登录人

# 可选
# XTOOLS_BASE_URL=https://crm.xtcrm.com/open/index.xt
# XTOOLS_TIMEOUT=30          # 客户端缺省 30 秒；scripts/sync.py 未设置时按 120 秒（订单表单页可能较慢）
# XTOOLS_SID_CACHE=.xtools_session.json
# XTOOLS_SID_TTL=1500
# XTOOLS_MIN_INTERVAL=0.2
